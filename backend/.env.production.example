# Deployment target: bharatchat.in. Fill secrets in the deployment secret manager.
# Empty values intentionally prevent startup. Never publish the development stack.
APP_ENV=production
HTTP_PORT=8080
LOG_LEVEL=info
JWT_ACCESS_SECRET=
JWT_ISSUER=https://api.bharatchat.in
JWT_AUDIENCE=bharatchat-clients
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=bharatchat
POSTGRES_PASSWORD=
POSTGRES_DB=bharatchat
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/app/secrets/postgres-ca.pem
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true
REDIS_TLS_SERVER_NAME=
OTP_DELIVERY_MODE=msg91
OTP_MSG91_AUTH_KEY=
OTP_MSG91_TEMPLATE_ID=
# Required: 1-20 owned/test E.164 numbers, comma-separated without spaces.
# Keep the real list in Secrets Manager, never in source control.
OTP_ALLOWED_PHONES=
MESSAGING_ENABLED=false
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_RATE_LIMIT=5
OTP_REQUEST_RATE_WINDOW_MINUTES=10
CORS_ALLOWED_ORIGINS=https://bharatchat.in
TRUSTED_PROXIES=
REQUIRE_E2EE=true
STORE_SESSION_NETWORK_METADATA=false
