APP_ENV=development
HTTP_PORT=8080

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=bharatchat
POSTGRES_PASSWORD=bharatchat_dev_password
POSTGRES_DB=bharatchat
POSTGRES_SSLMODE=disable
# Production: verify-full plus the mounted CA path.
POSTGRES_SSLROOTCERT=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_TLS_SERVER_NAME=

JWT_ACCESS_SECRET=change_this_access_secret_in_prod
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_ISSUER=bharatchat-api
JWT_AUDIENCE=bharatchat-clients

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=bharatchat_admin
S3_SECRET_KEY=bharatchat_dev_password
S3_BUCKET=bharatchat-media
S3_USE_SSL=false

FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON_PATH=/app/secrets/fcm-service-account.json

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_RATE_LIMIT=5
OTP_REQUEST_RATE_WINDOW_MINUTES=10
# Development may use console. Non-development requires msg91, webhook, or twilio.
OTP_DELIVERY_MODE=console
OTP_MSG91_AUTH_KEY=
OTP_MSG91_TEMPLATE_ID=
OTP_WEBHOOK_URL=
OTP_WEBHOOK_BEARER_TOKEN=
# Direct Twilio Messaging mode. Keep credentials in a deployment secret manager.
OTP_TWILIO_ACCOUNT_SID=
OTP_TWILIO_API_KEY=
OTP_TWILIO_API_SECRET=
OTP_TWILIO_MESSAGING_SERVICE_SID=
# Twilio mode requires {{CODE}} exactly once; {{MINUTES}} is optional.
# For Indian domestic SMS, this text must exactly match the approved DLT template.
OTP_SMS_MESSAGE_TEMPLATE=Your BharatChat verification code is {{CODE}}. It expires in {{MINUTES}} minutes. Do not share it.
CORS_ALLOWED_ORIGINS=*
# Comma-separated ingress/LB CIDRs. Empty means forwarded client-IP headers are ignored.
TRUSTED_PROXIES=

LOG_LEVEL=debug

# Privacy-safe defaults. Production refuses to start when E2EE is disabled.
REQUIRE_E2EE=false
STORE_SESSION_NETWORK_METADATA=false
